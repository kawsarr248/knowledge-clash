{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with RBAC role (teacher vs student) and stats",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["teacher", "student"] },
        "quizzesCreatedCount": { "type": "number" },
        "quizzesTakenCount": { "type": "number" },
        "totalScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "Category": {
      "title": "Category",
      "description": "Subject or topic category created and managed by teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 512 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "createdBy"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "A multiple choice quiz created manually or via AI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "language": { "type": "string", "maxLength": 32 },
        "category": { "type": "string", "maxLength": 64 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 128 },
        "shareCode": { "type": "string", "maxLength": 16 },
        "timeLimitMinutes": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "questionsCount": { "type": "number" },
        "playsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "language", "creatorId", "shareCode", "questionsCount"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "User completed attempt with score, time and detailed question responses including wrong answers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "quizId": { "type": "string", "maxLength": 128 },
        "quizTitle": { "type": "string", "maxLength": 256 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userPhotoURL": { "type": "string", "maxLength": 1024 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "wrongAnswersCount": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "quizId", "userId", "score", "totalQuestions", "percentage", "wrongAnswersCount"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Leaderboard entry for a quiz participant",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "quizId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userPhotoURL": { "type": "string", "maxLength": 1024 },
        "score": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "quizId", "userName", "score", "percentage", "timeSpentSeconds"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and role (teacher vs student)"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Subject categories managed by teachers"
    },
    "/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Quiz metadata and question sets"
    },
    "/quizzes/{quizId}/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Per-quiz leaderboard ranked by score and speed"
    },
    "/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Completed quiz attempt history with wrong answers analysis"
    }
  }
}
