rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The primary user kawsarr248@gmail.com is bootstrapped teacher, plus any user with role == 'teacher'
    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.email == 'kawsarr248@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity validation
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'displayName', 'role']) &&
        data.id is string && data.id.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 128 &&
        (data.role == 'teacher' || data.role == 'student');
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'createdBy']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.createdBy is string && data.createdBy.size() <= 128;
    }

    function isValidQuiz(data) {
      return data.keys().hasAll(['id', 'title', 'language', 'creatorId', 'shareCode', 'questionsCount']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
        data.language is string && data.language.size() <= 32 &&
        data.creatorId is string && data.creatorId.size() <= 128 &&
        data.shareCode is string && data.shareCode.size() <= 32 &&
        data.questionsCount is number && data.questionsCount >= 1 && data.questionsCount <= 100;
    }

    function isValidAttempt(data) {
      return data.keys().hasAll(['id', 'quizId', 'userId', 'score', 'totalQuestions', 'percentage', 'wrongAnswersCount']) &&
        data.id is string && data.id.size() <= 128 &&
        data.quizId is string && data.quizId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.score is number && data.score >= 0 &&
        data.totalQuestions is number && data.totalQuestions >= 1 &&
        data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
        data.wrongAnswersCount is number && data.wrongAnswersCount >= 0;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'quizId', 'userName', 'score', 'percentage', 'timeSpentSeconds']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.quizId is string && data.quizId.size() <= 128 &&
        data.userName is string && data.userName.size() <= 128 &&
        data.score is number && data.score >= 0 &&
        data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
        data.timeSpentSeconds is number && data.timeSpentSeconds >= 0;
    }

    // User profiles & roles (Teachers can assign teacher/student roles)
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if (isOwner(userId) || isTeacher()) && isValidUserProfile(request.resource.data);
    }

    // Categories (Managed by Teachers, readable by everyone)
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isTeacher() && isValidCategory(request.resource.data);
      allow update: if isTeacher() && isValidCategory(request.resource.data);
      allow delete: if isTeacher();
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if (isTeacher() || isSignedIn()) && request.resource.data.creatorId == request.auth.uid && isValidQuiz(request.resource.data);
      allow update: if (
        isTeacher() ||
        (isSignedIn() && resource.data.creatorId == request.auth.uid) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playsCount', 'averageScore', 'updatedAt'])
      ) && isValidQuiz(request.resource.data);
      allow delete: if isTeacher() || (isSignedIn() && resource.data.creatorId == request.auth.uid);

      // Subcollection leaderboard
      match /leaderboard/{userId} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidLeaderboardEntry(request.resource.data);
        allow delete: if isTeacher() || (isSignedIn() && request.auth.uid == userId);
      }
    }

    // Attempts (Student can view own, Teacher can view all)
    match /attempts/{attemptId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isTeacher());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isTeacher());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidAttempt(request.resource.data);
      allow update, delete: if false;
    }
  }
}
